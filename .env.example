# Copier ce fichier en .env puis renseigner les valeurs : cp .env.example .env
# .env est ignore par git. Ne jamais y commiter de secrets.
# Il est lu par docker compose ET par l'API lancee hors Docker (IntelliJ, ./mvnw spring-boot:run).
# Les valeurs contenant $ ou # doivent etre entourees de guillemets simples.

# Nom de la base (commun au MySQL local et au conteneur)
DB_NAME=gestionstock

# ============================================================
# Base de donnees utilisee HORS Docker (MySQL installe sur la machine)
# ============================================================
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD='changez-moi'

# ============================================================
# Base de donnees du conteneur MySQL (docker compose)
# L'API lancee dans Docker se connecte a mysql:3306 avec ces identifiants.
# ============================================================
# Utilisateur applicatif du conteneur (ne pas mettre "root" : l'image MySQL le refuse)
DOCKER_DB_USERNAME=gestionstock
DOCKER_DB_PASSWORD='changez-moi'
DOCKER_DB_ROOT_PASSWORD='changez-moi-aussi'

# ============================================================
# JPA / Hibernate
# ============================================================
# create | create-drop | update | validate | none
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# ============================================================
# API
# ============================================================
# Port d'ecoute hors Docker (dans Docker, l'API ecoute toujours sur 8081)
SERVER_PORT=8081

# Cle de signature JWT encodee en base64 : openssl rand -base64 48
JWT_SECRET=
# Duree de validite du jeton en millisecondes (36000000 = 10 h)
JWT_EXPIRATION_MS=36000000

# Origines autorisees, separees par des virgules (ex : http://localhost:4200,http://localhost:3000)
CORS_ALLOWED_ORIGINS=*

# Mot de passe du compte admin cree automatiquement avec une entreprise
ENTREPRISE_DEFAULT_PASSWORD='changez-moi'

# Serveur SMTP (futur module de mailing). Hors Docker : Mailpit publie sur localhost:1025
MAIL_HOST=localhost
MAIL_PORT=1025

# ============================================================
# Flickr (stockage des photos)
# ============================================================
FLICKR_API_KEY=
FLICKR_API_SECRET=
FLICKR_APP_KEY=
FLICKR_APP_SECRET=

# ============================================================
# Docker Compose : ports publies sur la machine hote
# ============================================================
API_HOST_PORT=8081
MYSQL_HOST_PORT=3307
ADMINER_HOST_PORT=8082
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# Options JVM passees a l'API (ex : -Xms256m -Xmx512m)
JAVA_OPTS=
